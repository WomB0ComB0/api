{
  "name": "@api/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile dist/server src/index.ts",
    "typecheck": "tsc --noEmit",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "export-openapi": "bun run src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/openapi": "^1.4.17",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@elysiajs/server-timing": "^1.4.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@resq-systems/dsa": "^3.0.0",
    "@resq-systems/logger": "^0.3.0",
    "@resq-systems/types": "^0.2.0",
    "effect": "^4.0.0",
    "elysia": "^1.4.32",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@types/bun": "^1.4.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@opentelemetry/sdk-node": ">=0.217.0",
    "@opentelemetry/exporter-prometheus": ">=0.217.0",
    "@opentelemetry/propagator-jaeger": ">=2.9.0"
  }
}
