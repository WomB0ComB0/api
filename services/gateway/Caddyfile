{
	auto_https off
	admin off
}

:{$PORT:8080} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	@gwhealth path /gateway/health
	handle @gwhealth {
		header Content-Type application/json
		respond `{"status":"healthy","service":"gateway"}` 200
	}

	# Route cdn.mikeodnis.dev traffic transparently to the Cloudflare Edge Worker + R2
	@cdn host cdn.mikeodnis.dev
	handle @cdn {
		reverse_proxy {$CDN_WORKER_UPSTREAM:https://cdn-worker.mikeodnis3242004.workers.dev} {
			header_up Host {upstream_hostport}
		}
	}

	@health path /health
	handle @health {
		reverse_proxy {$HEALTH_UPSTREAM:health-aggregator.railway.internal:8000}
	}

	@core path /v1/core /v1/core/*
	handle @core {
		reverse_proxy {$CORE_UPSTREAM:core-service.railway.internal:3000}
	}

	@media path /v1/media /v1/media/*
	handle @media {
		reverse_proxy {$MEDIA_UPSTREAM:media-service.railway.internal:8080}
	}

	@links path /v1/links /v1/links/*
	handle @links {
		uri strip_prefix /v1/links
		reverse_proxy {$HASURA_UPSTREAM:hasura.railway.internal:8080}
	}

	handle {
		header Content-Type application/json
		respond `{"service":"api.mikeodnis.dev","routes":["/health","/v1/core","/v1/media","/v1/links/graphql"]}` 200
	}
}
