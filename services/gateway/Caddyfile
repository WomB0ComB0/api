{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges 100.64.0.0/10 fc00::/7
		trusted_proxies_strict
	}
}

(proxy_defaults) {
	header_up -CF-Connecting-IP
	header_up -X-Real-IP
	lb_try_duration 3s
	lb_try_interval 250ms
	transport http {
		dial_timeout 5s
		response_header_timeout 30s
		keepalive 90s
		keepalive_idle_conns 64
		keepalive_idle_conns_per_host 32
	}
}

# Site-wide security headers. The - and ? operations make Caddy defer the whole block to a
# response-writer wrapper, which applies it when a route writes its response. An error (a
# file_server 404/405, or a reverse_proxy 502 when an upstream is down) is written by Caddy's error
# path instead, which never goes through that wrapper, so handle_errors imports the block again.
(security_headers) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		?Cross-Origin-Resource-Policy "same-site"
	}
}

:{$PORT:8080} {
	encode zstd gzip

	import security_headers

	# Every error keeps the status the route raised and gets an empty body, so no upstream address or
	# Go error text reaches the client. Routes set their Cache-Control, Content-Type and CSP before
	# file_server or reverse_proxy fails, so they are replaced here: an error is never cached, has no
	# content to type and allows nothing.
	handle_errors {
		import security_headers
		header {
			Cache-Control "no-store"
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
			-Content-Type
		}
		respond "" {err.status_code}
	}

	@gwhealth path /gateway/health
	handle @gwhealth {
		header Content-Type application/json
		respond `{"status":"healthy","service":"gateway"}` 200
	}

	# Route cdn.mikeodnis.dev traffic transparently to the Cloudflare Edge Worker + R2
	# Pass verified non-spoofable {client_ip} + shared proxy secret so cdn-worker can isolate per-visitor rate limits
	@cdn host cdn.mikeodnis.dev
	handle @cdn {
		reverse_proxy {$CDN_WORKER_UPSTREAM:https://cdn-worker.mikeodnis3242004.workers.dev} {
			header_up Host {upstream_hostport}
			header_up X-Gateway-Proxy-Secret {$GATEWAY_PROXY_SECRET:}
			header_up X-Gateway-Client-IP {client_ip}
			import proxy_defaults
		}
	}

	# Static LLM, AEO, OpenAPI portal, and RFC 9116 security discovery routes for api.mikeodnis.dev
	@securitytxt path /.well-known/security.txt
	handle @securitytxt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=86400"
		header Cross-Origin-Resource-Policy "cross-origin"
		rewrite * /security.txt
		root * /srv/static
		file_server
	}

	@robots path /robots.txt
	handle @robots {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		header Cross-Origin-Resource-Policy "cross-origin"
		root * /srv/static
		file_server
	}

	@sitemap path /sitemap.xml
	handle @sitemap {
		header Content-Type "application/xml; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		header Cross-Origin-Resource-Policy "cross-origin"
		root * /srv/static
		file_server
	}

	@icons path /favicon.ico /icon.svg /apple-touch-icon.png
	handle @icons {
		header Cache-Control "public, max-age=86400"
		header Cross-Origin-Resource-Policy "cross-origin"
		root * /srv/static
		file_server
	}

	@ogimage path /opengraph-image /opengraph-image.png /twitter-image /twitter-image.png
	handle @ogimage {
		header Content-Type "image/png"
		header Cache-Control "public, max-age=86400"
		header Cross-Origin-Resource-Policy "cross-origin"
		rewrite * /opengraph-image.png
		root * /srv/static
		file_server
	}

	@llms path /llms.txt /llms-full.txt
	handle @llms {
		header Content-Type "text/markdown; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		header Cross-Origin-Resource-Policy "cross-origin"
		header Link `<https://api.mikeodnis.dev/llms.txt>; rel="describedby"; type="text/markdown", <https://api.mikeodnis.dev/v1/core/openapi.json>; rel="service-desc"; type="application/openapi+json"`
		root * /srv/static
		file_server
	}

	# Shared subdomain fonts for the root page, the same files cdn.mikeodnis.dev serves:
	# Geist + Geist Mono 1.900 (OFL-1.1, same-origin so the root CSP's default-src 'self' covers them).
	# Font names carry their version, so they are cached as immutable; the cache headers go on files
	# that exist only, so a missing name is never cached for a year.
	@brandfonts path /_brand/fonts/*.woff2
	handle @brandfonts {
		@brandfonts_found file {
			root /srv/static
		}
		header @brandfonts_found {
			Content-Type "font/woff2"
			Cache-Control "public, max-age=31536000, immutable"
		}
		root * /srv/static
		file_server
	}

	@brandlicense path /_brand/fonts/OFL.txt
	handle @brandlicense {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=86400"
		root * /srv/static
		file_server
	}

	# The shared subdomain stylesheet for the root page (the bytes cdn.mikeodnis.dev inlines), cached
	# like the page itself.
	@brandcss path /_brand/subdomain.css
	handle @brandcss {
		header Content-Type "text/css; charset=utf-8"
		header Cache-Control "public, max-age=300"
		root * /srv/static
		file_server
	}

	@docs path /docs /docs/
	handle @docs {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=300"
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https://api.mikeodnis.dev https://cdn.mikeodnis.dev https://cdn.jsdelivr.net; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'"
		rewrite * /docs.html
		root * /srv/static
		file_server
	}

	@health path /health
	handle @health {
		reverse_proxy {$HEALTH_UPSTREAM:health-aggregator.railway.internal:8000} {
			import proxy_defaults
		}
	}

	@core path /v1/core /v1/core/*
	handle @core {
		reverse_proxy {$CORE_UPSTREAM:core-service.railway.internal:3000} {
			import proxy_defaults
		}
	}

	@media path /v1/media /v1/media/*
	handle @media {
		reverse_proxy {$MEDIA_UPSTREAM:media-service.railway.internal:8080} {
			import proxy_defaults
		}
	}

	# Fail-closed Hasura allowlist: expose ONLY public GraphQL + healthz and strip admin secret header
	# so /v1/metadata, /v1/query, /v2/query, /v1/version, /console, and admin-secret brute-forcing are blocked at the gateway.
	@links_graphql path /v1/links/v1/graphql /v1/links/graphql
	handle @links_graphql {
		request_body {
			max_size 256KB
		}
		rewrite * /v1/graphql
		reverse_proxy {$HASURA_UPSTREAM:hasura.railway.internal:8080} {
			header_up -X-Hasura-Admin-Secret
			header_up -X-Hasura-Access-Key
			import proxy_defaults
		}
	}

	@links_health path /v1/links/healthz
	handle @links_health {
		rewrite * /healthz
		reverse_proxy {$HASURA_UPSTREAM:hasura.railway.internal:8080} {
			header_up -X-Hasura-Admin-Secret
			header_up -X-Hasura-Access-Key
			import proxy_defaults
		}
	}

	@links_blocked path /v1/links /v1/links/*
	handle @links_blocked {
		header Content-Type application/json
		header Cache-Control "no-store"
		respond `{"error":"Not found"}` 404
	}

	@root_html {
		path /
		header Accept *text/html*
	}
	# / answers HTML here and JSON in the catch-all below, chosen by Accept, so both answers say
	# Vary: Accept for shared caches. + appends, so another Vary token (encode's) is never replaced.
	handle @root_html {
		header +Vary Accept
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=300"
		header Link `<https://api.mikeodnis.dev/llms.txt>; rel="describedby"; type="text/markdown", <https://api.mikeodnis.dev/v1/core/openapi.json>; rel="service-desc"; type="application/openapi+json", <https://api.mikeodnis.dev/.well-known/security.txt>; rel="security"`
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		rewrite * /index.html
		root * /srv/static
		file_server
	}

	handle {
		# Only / has an HTML answer (@root_html), so only its JSON answer varies by Accept. Every
		# other path gets this JSON whatever the client accepts and stays a single cache entry.
		header / +Vary Accept
		header Content-Type application/json
		header Link `<https://api.mikeodnis.dev/llms.txt>; rel="describedby"; type="text/markdown", <https://api.mikeodnis.dev/v1/core/openapi.json>; rel="service-desc"; type="application/openapi+json"`
		respond `{"service":"api.mikeodnis.dev","routes":["/health","/v1/core","/v1/media","/v1/links/graphql"],"docs":["https://api.mikeodnis.dev/docs","https://api.mikeodnis.dev/v1/core/docs"],"openapi":["https://api.mikeodnis.dev/v1/core/openapi.json","https://api.mikeodnis.dev/v1/media/openapi.json"],"llms":"https://api.mikeodnis.dev/llms.txt","security":"https://api.mikeodnis.dev/.well-known/security.txt","upload_studio":"https://cdn.mikeodnis.dev/upload"}` 200
	}
}
