{
	auto_https off
	admin off
}

(proxy_defaults) {
	lb_try_duration 3s
	lb_try_interval 250ms
	transport http {
		dial_timeout 5s
		response_header_timeout 30s
		keepalive 90s
		keepalive_idle_conns 64
		keepalive_idle_conns_per_host 32
	}
}

:{$PORT:8080} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		?Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		?Cross-Origin-Resource-Policy "same-site"
	}

	@gwhealth path /gateway/health
	handle @gwhealth {
		header Content-Type application/json
		respond `{"status":"healthy","service":"gateway"}` 200
	}

	# Route cdn.mikeodnis.dev traffic transparently to the Cloudflare Edge Worker + R2
	@cdn host cdn.mikeodnis.dev
	handle @cdn {
		reverse_proxy {$CDN_WORKER_UPSTREAM:https://cdn-worker.mikeodnis3242004.workers.dev} {
			header_up Host {upstream_hostport}
			import proxy_defaults
		}
	}

	# Static LLM, AEO, OpenAPI portal, and RFC 9116 security discovery routes for api.mikeodnis.dev
	@securitytxt path /.well-known/security.txt
	handle @securitytxt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=86400"
		header Cross-Origin-Resource-Policy "cross-origin"
		rewrite * /security.txt
		root * /srv/static
		file_server
	}

	@robots path /robots.txt
	handle @robots {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		header Cross-Origin-Resource-Policy "cross-origin"
		root * /srv/static
		file_server
	}

	@sitemap path /sitemap.xml
	handle @sitemap {
		header Content-Type "application/xml; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		header Cross-Origin-Resource-Policy "cross-origin"
		root * /srv/static
		file_server
	}

	@icons path /favicon.ico /icon.svg /apple-touch-icon.png
	handle @icons {
		header Cache-Control "public, max-age=86400"
		header Cross-Origin-Resource-Policy "cross-origin"
		root * /srv/static
		file_server
	}

	@ogimage path /opengraph-image /opengraph-image.png /twitter-image /twitter-image.png
	handle @ogimage {
		header Content-Type "image/png"
		header Cache-Control "public, max-age=86400"
		header Cross-Origin-Resource-Policy "cross-origin"
		rewrite * /opengraph-image.png
		root * /srv/static
		file_server
	}

	@llms path /llms.txt /llms-full.txt
	handle @llms {
		header Content-Type "text/markdown; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		header Cross-Origin-Resource-Policy "cross-origin"
		header Link `<https://api.mikeodnis.dev/llms.txt>; rel="describedby"; type="text/markdown", <https://api.mikeodnis.dev/v1/core/openapi.json>; rel="service-desc"; type="application/openapi+json"`
		root * /srv/static
		file_server
	}

	@docs path /docs /docs/
	handle @docs {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=300"
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https://api.mikeodnis.dev https://cdn.mikeodnis.dev https://cdn.jsdelivr.net; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'"
		rewrite * /docs.html
		root * /srv/static
		file_server
	}

	@health path /health
	handle @health {
		reverse_proxy {$HEALTH_UPSTREAM:health-aggregator.railway.internal:8000} {
			import proxy_defaults
		}
	}

	@core path /v1/core /v1/core/*
	handle @core {
		reverse_proxy {$CORE_UPSTREAM:core-service.railway.internal:3000} {
			import proxy_defaults
		}
	}

	@media path /v1/media /v1/media/*
	handle @media {
		reverse_proxy {$MEDIA_UPSTREAM:media-service.railway.internal:8080} {
			import proxy_defaults
		}
	}

	@links path /v1/links /v1/links/*
	handle @links {
		uri strip_prefix /v1/links
		reverse_proxy {$HASURA_UPSTREAM:hasura.railway.internal:8080} {
			import proxy_defaults
		}
	}

	@root_html {
		path /
		header Accept *text/html*
	}
	handle @root_html {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=300"
		header Link `<https://api.mikeodnis.dev/llms.txt>; rel="describedby"; type="text/markdown", <https://api.mikeodnis.dev/v1/core/openapi.json>; rel="service-desc"; type="application/openapi+json", <https://api.mikeodnis.dev/.well-known/security.txt>; rel="security"`
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		rewrite * /index.html
		root * /srv/static
		file_server
	}

	handle {
		header Content-Type application/json
		header Link `<https://api.mikeodnis.dev/llms.txt>; rel="describedby"; type="text/markdown", <https://api.mikeodnis.dev/v1/core/openapi.json>; rel="service-desc"; type="application/openapi+json"`
		respond `{"service":"api.mikeodnis.dev","routes":["/health","/v1/core","/v1/media","/v1/links/graphql"],"docs":["https://api.mikeodnis.dev/docs","https://api.mikeodnis.dev/v1/core/docs"],"openapi":["https://api.mikeodnis.dev/v1/core/openapi.json","https://api.mikeodnis.dev/v1/media/openapi.json"],"llms":"https://api.mikeodnis.dev/llms.txt","security":"https://api.mikeodnis.dev/.well-known/security.txt","upload_studio":"https://cdn.mikeodnis.dev/upload"}` 200
	}
}
