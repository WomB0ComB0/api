# Gateway (generate htpasswd hash with: htpasswd -nbB admin 'password')
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=changeme

# Shared Auth Secret (minimum 32 chars in production: openssl rand -hex 32)
JWT_SECRET=development-jwt-secret-change-me-32chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Shared CDN Private-URL Signing Secret (must match cdn.mikeodnis.dev Worker SIGNING_SECRET)
SIGNING_SECRET=development-signing-secret-change-me-32b!

# Cloudflare R2 & CDN Cache Purge
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET=your-bucket-name
CLOUDFLARE_R2_PUBLIC_URL=https://cdn.mikeodnis.dev
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_API_TOKEN=your-api-token

# Database
POSTGRES_DB=api
POSTGRES_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/api

# Hasura (key must match JWT_SECRET)
HASURA_GRAPHQL_ADMIN_SECRET=dev-hasura-admin-secret
HASURA_GRAPHQL_JWT_SECRET={"type":"HS256","key":"development-jwt-secret-change-me-32chars!"}
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=anonymous

# Observability (optional: leave OTEL_EXPORTER_OTLP_ENDPOINT blank to disable)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_ENDPOINT=
OTEL_EXPORTER_TOKEN=
BETTERSTACK_SOURCE_TOKEN=

# Environment
NODE_ENV=development
GO_ENV=development
